# .env.example — content-pipeline-stack
#
# 复制这个文件: cp .env.example .env
# 设置权限:     chmod 600 .env
# 生成 token:   openssl rand -hex 32

# ─── content-pipeline-mcp ─────────────────────────────────────────────────────
# Bearer Token for MCP /mcp 端点 (req for production)
# 必须设置!生产环境留空 = 警告 + 使用默认 dev token (不安全)
MCP_TOKEN=change-me-to-random-32-bytes-hex

# 临时绕过 auth (开发环境,生产严禁设)
# MCP_NO_AUTH=1

# ─── file-service ─────────────────────────────────────────────────────────────
# Token for file-service 上传端点
FS_UPLOAD_TOKEN=change-me-to-random-32-bytes-hex

# ─── Yuxi integration (Week 3) ─────────────────────────────────────────────────
# Bearer Token from HZ Yuxi (/api/auth/token)
YUXI_TOKEN=change-me-when-yuxi-integration-starts

# Yuxi HTTP base URL
YUXI_BASE_URL=https://hz.siqing.cn/yuxi

# ─── douyin-recorder ──────────────────────────────────────────────────────────
# 留空 = 不启用 (默认)
# 设置 = 在线 dashboard auth token
DOUYIN_RECORDER_DASHBOARD_TOKEN=

# ─── v6-monitor ───────────────────────────────────────────────────────────────
# SQLite database path (use default = /home/main/douyin-data/queue.db)
# DOUYIN_DATA_DB=/home/main/douyin-data/queue.db

# 监控间隔 (hours, 默认 6)
# MONITOR_INTERVAL_HOURS=6
