# content-pipeline-stack — .env.example
# 别人 clone 仓库后, cp .env.example .env 然后改路径即可。
# 默认值是 HK 当前布局 (Cove 04 维护), 别人用自己的路径替换。

# ═══════════════════════════════════════════════════════════════════
# 关键路径 (docker compose 用这些)
# ═══════════════════════════════════════════════════════════════════

# 主数据盘 (queue.db / state.db / transcripts / videos / downloads / kb)
# 默认: HK /home/main/douyin-data (symlink → /mnt/douyin-data)
DATA_DIR=/home/main/douyin-data

# file-service 上传目录 (mp4 上传后落到这)
# 默认: HK /home/main/uploads (symlink → /mnt/douyin-data/uploads-migrated)
UPLOADS_DIR=/home/main/uploads

# OpenClaw 工作区 (skills 源码: brand-video-tools / douyin-batch / knowledge-distill)
# 默认: HK /home/main/.openclaw
OPENCLAW_DIR=/home/main/.openclaw

# douyin-recorder 源码目录 (config.ini / downloads / logs / backup_config)
# 默认: HK /home/main/DouyinLiveRecorder
RECORDER_DIR=/home/main/DouyinLiveRecorder

# Playwright 浏览器缓存 (chromium bind mount, 不进 image)
# 默认: HK /home/main/.cache/ms-playwright
PLAYWRIGHT_DIR=/home/main/.cache/ms-playwright

# ═══════════════════════════════════════════════════════════════════
# 本地 registry (push/pull image 走这里)
# ═══════════════════════════════════════════════════════════════════

# 别人部署时改成自己的 registry URL (例如 harbor.example.com)
REGISTRY_URL=localhost:5000

# image tag (别人 clone 仓库时, 跟 git tag 一致)
IMAGE_TAG=0.1.0

# ═══════════════════════════════════════════════════════════════════
# v6 worker 调外部服务 (host.docker.internal 默认指向 docker host)
# ═══════════════════════════════════════════════════════════════════

# HK ASR 转录服务 (transcribe worker 调这里)
HK_ASR_URL=http://host.docker.internal:18200

# file-service 上传服务 (upload worker 调这里)
FILE_SERVICE_URL=http://host.docker.internal:18098

# ═══════════════════════════════════════════════════════════════════
# 时区 (统一 Asia/Shanghai)
# ═══════════════════════════════════════════════════════════════════

TZ=Asia/Shanghai
# Phase 4-ii (2026-07-28): text-distill-service Bearer token (跟 /etc/text-distill-service.env 一致)
TEXT_DISTILL_TOKEN=
