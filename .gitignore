# Environment (systemd token + private urls)
.env
.env.local
.env.*.local

# Node
**/node_modules/
**/npm-debug.log*

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/
.coverage
htmlcov/

# Docker
**/.dockerignore
!services/**/.dockerignore  # keep service .dockerignore
Dockerfile.local

# Build artifacts (TypeScript → dist)
**/dist/
**/build/
**/*.tsbuildinfo

# Logs
**/*.log

# Runtime
**/state.db
**/state.db-*
**/download_list.json
**/last_seen.json
**/browse_records.json
**/server_state.json
**/file_health.json

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Temp
**/tmp/
**/temp/
**/*.tmp
**/*.bak
!**/*.bak.*   # keep .bak.2026-07-04 style backups
!**/*.bak-20260725  # keep dated backups

# Secret backups
**/*.pem
**/*.key
**/*.crt
**/cookies/*.txt
**/browser_fallback_stats.json

# video / downloads (don't accidentally git add huge files)
downloads/
**/*.mp4
**/*.mp3
**/*.flv
**/*.ts

# git subprojects (those have own .git)
Obsidian/
TikTokDownloader/
deer-flow/
OpenSpec/
