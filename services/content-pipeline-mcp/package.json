{
  "name": "content-pipeline-mcp",
  "version": "0.1.0",
  "description": "MCP server for content pipeline (monitor→download→transcribe→distill→upload→ingest)",
  "private": true,
  "bin": {
    "content-pipeline-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "sync-dist": "tsc && echo '✅ dist/ 已同步 (mtime >= 所有 src/)'",
